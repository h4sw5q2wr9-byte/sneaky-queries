# Optional overrides for src/data/firebase.web.json (public web configuration).
# Blank values retain the included defaults. Never put Admin credentials here.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# For local emulator use ONLY; leave false for real friends / deployment.
VITE_USE_EMULATORS=false
# Root hosting: /. Repository Pages hosting: /sneaky-queries/
VITE_BASE_PATH=/
