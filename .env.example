# Public Firebase web app configuration. Never put Admin SDK/service account credentials here.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# For local emulator use ONLY; leave false for real friends / deployment.
VITE_USE_EMULATORS=false
# Root hosting: /. Repository Pages hosting: /sneaky-queries/
VITE_BASE_PATH=/
